rules_version = '2';

// TaskNow - Firebase Storage security rules
//
// Paste this into Firebase Console -> Storage -> Rules (or deploy with
// `firebase deploy --only storage`). See FIREBASE_SETUP.md.
//
// NOTE ON PRIVACY: uploaded files (avatars, task photos, blog images,
// AND identity verification documents) are all displayed as plain
// <img src="..."> tags in the app. Browsers can't attach a Firebase
// Auth header to an <img> request, so read access here has to be public
// - the only thing protecting a file is that its download URL contains
// a long random token that isn't guessable or listed anywhere. This is
// a reasonable trade-off for a Spark-plan app with no backend, but it
// is NOT the same as "only admins/the user can view their ID photos".
// If that matters for you, the fix is a Cloud Function (or any small
// server) that serves files after checking the caller's identity - out
// of scope for this "no Cloud Functions" setup.
service firebase.storage {
  match /b/{bucket}/o {
    match /uploads/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*|application/pdf');
    }
  }
}
